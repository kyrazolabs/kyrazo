# HAProxy Backend IP Configuration
# Copy this file to .env and replace the values with your actual IPs

# Certificate name without the FILE EXTENSION
CERTIFICATE_NAME=

# Ingest Servers
INGEST_SERVER1_IP=10.0.1.11:3000
INGEST_SERVER2_IP=10.0.1.12:3000

# Dashboard Servers
DASHBOARD_SERVER1_IP=10.0.2.11:4000
DASHBOARD_SERVER2_IP=10.0.2.12:4000

# Default API Servers
API_SERVER1_IP=10.0.0.11:6000
API_SERVER2_IP=10.0.0.12:6000
