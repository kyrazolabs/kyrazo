# HAProxy Backend IP Configuration
# Copy this file to .env and replace the values with your actual IPs

# Use host.docker.internal to reach services running on the same Docker host
# Use actual IPs (e.g. 10.0.1.11:3000) for services running on different servers

# Ingest Servers
INGEST_SERVER1_IP=host.docker.internal:9000
INGEST_SERVER2_IP=host.docker.internal:9000

# Dashboard Servers
DASHBOARD_SERVER1_IP=host.docker.internal:3003
DASHBOARD_SERVER2_IP=host.docker.internal:3003

# Default API Servers (Integration)
API_SERVER1_IP=host.docker.internal:6000
API_SERVER2_IP=host.docker.internal:6000

# Host Port Configuration
# Change these if ports 80/443 are already in use on your server (e.g. by Coolify Proxy)
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443
