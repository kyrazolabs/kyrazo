# ═══════════════════════════════════════════════════════
# Rust Load Balancer — Environment Variables
# ═══════════════════════════════════════════════════════
# Copy this file to .env and configure for your environment.
#
# Coolify: Set these as environment variables in the
# service configuration panel.
# ═══════════════════════════════════════════════════════

# ── Logging ───────────────────────────────────────────
# info  = JSON structured logs (production)
# debug = pretty colored logs (development)
RUST_LOG=info

# ── Port (Coolify sets this automatically) ────────────
PORT=8080
