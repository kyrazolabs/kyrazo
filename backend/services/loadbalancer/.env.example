# ═══════════════════════════════════════════════════════
# Loadbalancer — Environment Variables
# ═══════════════════════════════════════════════════════
# Copy this file to .env and configure for your environment.
#
# Coolify: Set these as environment variables in the
# service configuration panel.
# ═══════════════════════════════════════════════════════

# ── Logging ───────────────────────────────────────────
# debug = verbose logs showing health check errors (BEST FOR DEBUGGING)
# info  = JSON structured logs (production)
RUST_LOG=debug

# ── Port ──────────────────────────────────────────────
PORT=8080

# ── Backend Server IPs ────────────────────────────────
# Ingest API servers (handles /ingest/* routes)
INGEST_SERVER1_IP=http://10.0.0.10:3001
INGEST_SERVER2_IP=http://10.0.0.11:3001

# Dashboard API servers (handles /dashboard/* routes)
DASHBOARD_SERVER1_IP=http://10.0.0.10:3002
DASHBOARD_SERVER2_IP=http://10.0.0.11:3002

# Integration/Default API servers (handles /* catch-all)
BIND=0.0.0.0:8080
METRICS_BIND=0.0.0.0:9090
SKIP_SSL_VERIFY=false
API_SERVER1_IP=http://10.0.0.10:3000
API_SERVER2_IP=http://10.0.0.11:3000

# ── Health Check ──────────────────────────────────────
HEALTH_CHECK_PATH=/v1/health
HEALTH_CHECK_INTERVAL=5
HEALTH_CHECK_TIMEOUT=5

# ── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_RPS=1000
RATE_LIMIT_BURST=2000
