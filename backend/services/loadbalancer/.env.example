CERTIFICATE_NAME=

# Ingest Servers
INGEST_SERVER1_IP=10.0.1.11
INGEST_SERVER2_IP=10.0.1.12

# Dashboard Servers
DASHBOARD_SERVER1_IP=10.0.2.11
DASHBOARD_SERVER2_IP=10.0.2.12

# Default API Servers
API_SERVER1_IP=10.0.0.11
API_SERVER2_IP=10.0.0.12
