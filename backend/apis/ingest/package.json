{
  "name": "ingest",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "bun run dist/index.js",
    "dev": "bun run --hot src/index.ts",
    "prod": "bun run src/cluster.ts",
    "tunnel": "bun run src/tunnel.ts",
    "watch": "concurrently -k -n TSC -c blue \"tsc -p tsconfig.json -w\"",
    "build": "tsc -p tsconfig.json",
    "build:watch": "bun run build && bun run watch",
    "build:prod": "bun build  --production --target=bun --outdir=dist ./src",
    "rebuild": "rm -rf dist && bun run build",
    "clean": "rm -rf dist && echo 'Done.'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@arcjet/bun": "^1.3.0",
    "@hono/zod-validator": "^0.7.6",
    "@kyrazo/shared": "file:../../shared",
    "@types/dotenv": "^8.2.3",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.10",
    "@types/winston": "^2.4.4",
    "bullmq": "^5.71.1",
    "dotenv": "^17.3.1",
    "hono": "^4.12.9",
    "hono-error-handler": "^1.0.0",
    "ioredis": "^5.10.1",
    "mongoose": "^9.3.3",
    "morgan": "^1.10.1",
    "nats": "^2.29.3",
    "p-limit": "^7.3.0",
    "rate-limiter-flexible": "^9.1.1",
    "smee-client": "^5.0.0",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@types/bun": "latest",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "prettier": "3.6.2",
    "typescript-eslint": "^8.57.2"
  }
}