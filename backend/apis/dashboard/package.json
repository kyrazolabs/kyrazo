{
    "name": "@dashboard/api",
    "scripts": {
        "start": "bun run dist/index.js",
        "dev": "bun run --hot src/index.ts",
        "tunnel": "bun run src/tunnel.ts",
        "typecheck": "bunx tsc --noEmit",
        "test": "bun test",
        "clean": "rm -rf dist && echo 'Done.'",
        "build": "tsc -p tsconfig.json && bunx tsc-alias -p tsconfig.json && mkdir -p dist/templates/emails && cp src/templates/emails/*.html dist/templates/emails/",
        "build:watch": "bun run build && bun run watch",
        "prod": "bun run build && bun run src/index.ts",
        "watch": "concurrently -k -n TSC -c blue \"tsc -p tsconfig.json -w\"",
        "rebuild": "rm -rf dist && bun run build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@arcjet/bun": "^1.3.0",
        "@arcjet/inspect": "^1.3.0",
        "@bull-board/hono": "^6.20.6",
        "@clerk/backend": "^2.33.1",
        "@clickhouse/client": "^1.18.2",
        "@hono/clerk-auth": "^3.1.0",
        "@hono/zod-validator": "^0.7.6",
        "@kyrazo/shared": "file:../../shared",
        "@nats-io/transport-node": "^3.3.1",
        "@octokit/webhooks": "^14.2.0",
        "@paypal/paypal-server-sdk": "1.1.0",
        "@scalar/hono-api-reference": "^0.9.48",
        "@sentry/bun": "^10.46.0",
        "@types/bcrypt": "^6.0.0",
        "@types/bcryptjs": "^3.0.0",
        "@types/dotenv": "^8.2.3",
        "@types/got": "^9.6.12",
        "@types/he": "^1.2.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mongoose": "^5.11.97",
        "@types/morgan": "^1.9.10",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^7.0.11",
        "@types/winston": "^2.4.4",
        "axios": "^1.13.6",
        "bullmq": "^5.71.1",
        "dotenv": "^17.3.1",
        "drizzle-orm": "^0.45.1",
        "google-auth-library": "^10.6.2",
        "got": "^14.6.6",
        "he": "^1.2.0",
        "hono": "^4.12.9",
        "hono-error-handler": "^1.0.0",
        "ioredis": "^5.10.1",
        "jsonwebtoken": "^9.0.3",
        "mongodb-memory-server": "^10.4.3",
        "mongoose": "^9.3.3",
        "morgan": "^1.10.1",
        "nanoid": "^5.1.7",
        "nats": "^2.29.3",
        "node-cron": "^4.2.1",
        "nodemailer": "^7.0.13",
        "otplib": "^13.4.0",
        "p-limit": "^7.3.0",
