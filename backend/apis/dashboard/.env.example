# App Configuration
PORT=3003
NODE_ENV=development
HOST=0.0.0.0
APP_NAME=Kyrazo
APP_VERSION=1.0.0
APP_URL=http://localhost:3003
BRAND_NAME=Kyrazo
FRONTEND_URL=http://localhost:4200

# Database - MongoDB
MONGODB_URI=mongodb://localhost:27017/kyrazo
DB_NAME=kyrazo

# Database - ClickHouse
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Database - Postgres
POSTGRES_URL=postgres://user:password@localhost:5432/kyrazo
POSTGRES_MAX_POOL=10
POSTGRES_IDLE_TIMEOUT=30000
POSTGRES_CONNECTION_TIMEOUT=2000

# Redis & Queues
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

QUEUE_REDIS_URL=redis://localhost:6379/1
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=
QUEUE_REDIS_DB=1

# NATS Configuration
NATS_SERVERS=nats://localhost:4222
NATS_USER=
NATS_PASSWORD=
NATS_STREAM=kyrazo_events
NATS_CONSUMER_GROUP=dashboard_group
NATS_MAX_RECONNECT_ATTEMPTS=10
NATS_RECONNECT_TIME_WAIT=2000
NATS_TIMEOUT=10000

# Security & Auth
JWT_SECRET=your-super-secret-jwt-key
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret
JWT_ACCESS_EXPIRES_IN=15h
JWT_REFRESH_EXPIRES_IN=7d
RESET_TOKEN_EXPIRY=1h
VERIFICATION_TOKEN_EXPIRY=24h
SESSION_SECRET=your-session-secret
ENCRYPTION_KEY=your-32-char-encryption-key
ENCRYPT_KEY=your-32-char-encryption-key
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:4200
CORS_CREDENTIALS=true

# 2FA Configuration
TWO_FA_SERVICE_NAME=Kyrazo
TWO_FA_ISSUER=Kyrazo

# Email - Resend
RESEND_KEY=re_123456789
RESEND_RATE_LIMIT=10
RESEND_RATE_LIMIT_MINUTE=100
RESEND_RETRY_ATTEMPTS=3
RESEND_RETRY_BACKOFF=1000
RESEND_WEBHOOKS_ENABLED=true
RESEND_WEBHOOK_SECRET=whsec_your_secret

# Email Details
FROM_EMAIL=hello@kyrazo.com
FROM_NAME=Kyrazo
SUPPORT_EMAIL=support@kyrazo.com
ABUSE_EMAIL=abuse@kyrazo.com
PARTNERSHIPS_EMAIL=partners@kyrazo.com

# Stripe Integration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MAIN_PRODUCT_ID=prod_...
BILLING_BASE_URL=http://localhost:3003
BILLING_ADMIN_EMAIL=admin@kyrazo.com

# Integrations
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-key
ARCJET_ENV=development
ARCJET_KEY=aj_...

# Logging & Monitoring
LOG_LEVEL=info
LOG_FILE=logs/app.log
ERROR_LOG_FILE=logs/error.log

# Batching & Retention
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY=5000
ACTIVITY_LOG_RETENTION_DAYS=90
ACTIVITY_LOG_BATCH_SIZE=100

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/