# Database Configuration
MONGODB_URI=mongodb://mongo:27017/hookify
DB_NAME=hookify

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_ACCESS_SECRET=your-access-token-secret
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_ACCESS_EXPIRES_IN=15h
JWT_REFRESH_EXPIRES_IN=7d

# Server Configuration
PORT=3000
NODE_ENV=production
HOST=0.0.0.0

# Redis Configuration (for BullMQ jobs)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_REDIS_URL=redis://redis:6379/1

# NATS Configuration (for events)
NATS_SERVERS=nats://nats:4222
NATS_USER=
NATS_PASSWORD=
NATS_STREAM=billing_events
NATS_CONSUMER_GROUP=billing_consumer

# ClickHouse Configuration
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_HOST=http://clickhouse:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Stripe Configuration (BILLING)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
BILLING_BASE_URL=http://localhost:3000
BILLING_ADMIN_EMAIL=admin@yourdomain.com

# BullMQ Configuration
BULLMQ_PREFIX=billing

# Email Configuration (for notifications)
RESEND_KEY=your_resend_api_key
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Hookify

# Frontend URL (for redirects)
FRONTEND_URL=http://localhost:4200

# Security
ENCRYPT_KEY=your-32-character-encryption-key
ENCRYPTION_KEY=your-encryption-key-for-sensitive-data
BCRYPT_ROUNDS=12

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/

# CORS
CORS_ORIGIN=http://localhost:4200,http://localhost:3000