							"mode": "raw",
							"raw": "{\n    \"cancelAtPeriodEnd\": false,\n    \"reason\": \"No longer needed\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base}}/v1/subscriptions/:id/cancel",
							"host": [
