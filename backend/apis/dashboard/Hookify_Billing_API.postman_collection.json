				}
			]
		},
		{
			"name": "Payments",
			"item": [
				{
					"name": "Subscribe (Start Payment)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"planId\": \"plan_id_here\",\n    \"quantity\": 1,\n    \"metadata\": {}\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base}}/v1/payments/subscribe",
							"host": [
								"{{base}}"
							],
							"path": [
								"payments",
								"subscribe"
							]
						}
					}
				},
				{
					"name": "Create Billing Portal Session",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"returnUrl\": \"http://localhost:4200/dashboard/settings\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base}}/v1/payments/portal",
							"host": [
								"{{base}}"
							],
							"path": [
								"payments",
								"portal"
							]
						}
					}
				},
				{
					"name": "Webhook (Stripe)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Stripe-Signature",
								"value": "",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"id\": \"evt_test_webhook\",\n    \"object\": \"event\",\n    \"type\": \"payment_intent.succeeded\",\n    \"data\": {\n        \"object\": {\n            \"id\": \"pi_test\"\n        }\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base}}/v1/payments/webhook",
							"host": [
								"{{base}}"
							],
							"path": [
								"payments",
								"webhook"
							]
						}
					}
				}
			]
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"pm.request.headers.add({key: 'x-workspace-id', value: pm.environment.get('workspaceId') });"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "base",
			"value": "http://localhost:3000/v1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "workspaceId",
			"value": "",
			"type": "string"
		}
	]
}