{
	"info": {
		"_postman_id": "dashboard-api-collection",
		"name": "Hookify Dashboard API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Plans",
			"item": [
				{
					"name": "Create Plan",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Pro Plan\",\n    \"slug\": \"pro-plan\",\n    \"description\": \"Professional plan for growing teams\",\n    \"priceCents\": 2900,\n    \"currency\": \"USD\",\n    \"interval\": \"month\",\n    \"features\": {\n        \"sso\": true,\n        \"audit_logs\": true\n    },\n    \"limits\": {\n        \"eventsPerSecond\": 100,\n        \"eventsPerMonth\": 100000,\n        \"maxProjects\": 10,\n        \"maxMembers\": 5,\n        \"maxConnectors\": 20,\n        \"maxIntegrations\": 20,\n        \"maxConcurrent\": 50\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base}}/v1/plans",
							"host": [
								"{{base}}"
							],
							"path": [
								"plans"
							]
						}
					}
				},
				{
					"name": "List Plans",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base}}/v1/plans?active=true&limit=10&offset=0",
							"host": [
								"{{base}}"
							],
							"path": [
								"plans"
							],
							"query": [
								{
									"key": "active",
									"value": "true"
								},
								{
									"key": "limit",
									"value": "10"
								},
								{
									"key": "offset",
									"value": "0"
								}
							]
						}
					}
				},
				{
					"name": "Get Plan by Slug",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base}}/v1/plans/:slug",
							"host": [
								"{{base}}"
							],
							"path": [
								"plans",
								":slug"
							],
							"variable": [
								{
									"key": "slug",
									"value": "pro-plan"
								}
							]
						}
					}
				},
				{
					"name": "Update Plan",
					"request": {
						"method": "PATCH",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Pro Plan Updated\",\n    \"priceCents\": 3900\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base}}/v1/plans/:id",
							"host": [
								"{{base}}"
							],
							"path": [
								"plans",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "plan_id_here"
								}
							]
						}
					}
				},
				{
					"name": "Delete Plan",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base}}/v1/plans/:id",
							"host": [
								"{{base}}"
							],
							"path": [
								"plans",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "plan_id_here"
								}
							]
						}
					}
				},
				{
					"name": "Regenerate Stripe Price",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base}}/v1/plans/:id/regenerate-stripe-price",
							"host": [
								"{{base}}"
							],
							"path": [
								"plans",
								":id",
								"regenerate-stripe-price"
							],
							"variable": [
								{
									"key": "id",
									"value": "plan_id_here"
								}
							]
						}
					}
				},
				{
					"name": "Fix All Stripe Prices",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base}}/v1/plans/fix-stripe-prices",
							"host": [
								"{{base}}"
							],
							"path": [
								"plans",
								"fix-stripe-prices"
							]
						}
					}
				}
			]
		},
		{
