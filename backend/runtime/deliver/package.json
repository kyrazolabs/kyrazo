{
    "name": "deliver",
    "module": "src/index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "test": "bun test",
        "test:coverage": "bun test --coverage",
        "test:coverage:html": "bun test --coverage --coverage-reporter=lcov && bunx -y @lcov-viewer/cli lcov coverage/lcov.info -o coverage/html",
        "start": "bun run src/index.ts",
        "typecheck": "bunx tsc --noEmit",
        "dev": "bun run --hot src/index.ts",
        "prod": "bun run src/cluster.ts",
        "tunnel": "bun run src/tunnel.ts",
        "build": "tsc -p tsconfig.json",
        "build:watch": "bun run build && bun run watch",
        "watch": "concurrently -k -n TSC -c blue \"tsc -p tsconfig.json -w\"",
        "rebuild": "rm -rf dist && bun run build",
        "clean": "rm -rf dist && echo 'Done.'",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@eslint/js": "^9.37.0",
        "@eslint/json": "^0.13.2",
        "@supabase/supabase-js": "^2.88.0",
        "@types/bun": "latest",
        "concurrently": "^9.2.1",
        "eslint": "^9.37.0",
        "globals": "^16.4.0",
        "install": "^0.13.0",
        "typescript": "^5",
        "typescript-eslint": "^8.45.0"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1035.0",
        "@aws-sdk/client-sqs": "^3.1032.0",
        "@aws-sdk/s3-request-presigner": "^3.1035.0",
        "@bull-board/api": "^6.13.0",
        "@bull-board/express": "^6.13.0",
        "@bull-board/ui": "^6.13.0",
        "@clickhouse/client": "^1.12.1",
        "@kyrazo/shared": "file:../../shared",
        "@types/express": "^5.0.0",
        "@types/got": "^9.6.12",
        "@types/lodash": "^4.17.24",
        "@types/mongoose": "^5.11.97",
        "buffer-crc32": "^1.0.0",
        "bullmq": "^5.60.0",
        "crypto": "^1.0.1",
        "dayjs": "^1.11.20",
        "dotenv": "^17.2.1",
        "express": "^5.0.1",
        "got": "^14.4.9",
        "hono": "^4.12.2",
        "ioredis": "^5.3.0",
        "jsonwebtoken": "^9.0.0",
        "lodash": "^4.18.1",
        "mongoose": "^8.18.3",
        "nats": "^2.29.3",
        "redis": "^5.8.2",
        "smee-client": "^5.0.0",
        "stripe": "^20.1.0",
        "winston": "^3.18.1"
    }
}
