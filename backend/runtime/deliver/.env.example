WORKERS=1
NODE_ENV=production

# Database Configuration
MONGODB_SSL=true
MONGODB_URI=mongodb://localhost:27017/hookify
MONGODB_DB_NAME=hookify
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=5

REDIS_TLS=true
