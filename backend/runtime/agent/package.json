{
  "name": "agent",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "bun run dist/index.js",
    "dev": "bunx --bun @dotenvx/dotenvx run -f .env.prod -- bun run --hot src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:watch": "bun run build && bun run watch",
    "watch": "concurrently -k -n TSC -c blue \"tsc -p tsconfig.json -w\"",
    "rebuild": "rm -rf dist && bun run build",
    "clean": "rm -rf dist && echo 'Done.'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "latest",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "prettier": "3.7.4",
    "typescript-eslint": "^8.50.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@kyrazo/shared": "file:../../shared",
    "dotenv": "^17.2.3",
    "pm2": "^6.0.14"
  }
}